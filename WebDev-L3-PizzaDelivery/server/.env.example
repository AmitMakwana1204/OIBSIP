# PizzaHub Server Environment Variables

# Server Port
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and cluster details with your MongoDB Atlas credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pizzahub?retryWrites=true&w=majority

# JWT Authentication Secret (Generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Frontend Client URL (Deployed Vercel URL without trailing slash)
# For production: https://pizzahub.vercel.app
# For local development: http://localhost:5173
CLIENT_URL=https://your-frontend.vercel.app

# Backend Server URL (Deployed Render URL without trailing slash)
# For production: https://pizzahub-backend.onrender.com
# For local development: http://localhost:5000
SERVER_URL=https://your-backend.onrender.com

# Nodemailer Email Configuration (Gmail App Password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-16-character-app-password
